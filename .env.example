# Скопіюйте цей файл у .env і впишіть свій ключ ТАМ, а не тут.
# .env у .gitignore — у репозиторій не потрапить. Цей файл — потрапить.
DEEPSEEK_API_KEY=sk-впишіть-сюди-свій-ключ

# Необовʼязково:
# UKTZED_MODEL=deepseek-v4-flash
# UKTZED_BASE_URL=https://api.deepseek.com
# UKTZED_DENSE=1

# --- Стелі публічного /classify -------------------------------------------
# Ендпоінт відкритий і без авторизації, а кожен виклик коштує грошей.
# Усі значення нижче мають робочі дефолти в коді — задавати тут не обовʼязково,
# це лише точки налаштування, коли демо піде до людей.

# Кому можна звертатися з браузера (CORS), через кому.
# Дефолт: домен портфоліо + localhost. Сторінку демо, яку віддає сам FastAPI,
# це не стосується — вона того самого origin.
# UKTZED_ALLOWED_ORIGINS=https://agents-that-don-t-invent-production.up.railway.app

# Ковзне вікно на одну IP: скільки запитів за скільки секунд.
# UKTZED_RATE_LIMIT=12
# UKTZED_RATE_WINDOW=600

# Стеля довжини опису товару. Без неї будь-хто шле мегабайт прямо в промпт.
# UKTZED_MAX_CHARS=500

# Стеля реплік на одну сесію. Історія росте з кожним ходом і щоразу
# вирушає в API, тож без стелі вартість однієї розмови необмежена.
# UKTZED_MAX_TURNS=12

# Скільки живих сесій тримати в памʼяті.
# UKTZED_MAX_SESSIONS=500

# Таймаут відповіді LLM у секундах. Без нього зависла відповідь тримає воркер.
# UKTZED_LLM_TIMEOUT=60
